mus:Agrupacion rdf:type owl:Class .
mus:Agrupacion rdfs:comment "Artista colectivo identificado explícitamente por la fuente."@es .
mus:Agrupacion rdfs:label "Agrupación"@es .
mus:Agrupacion rdfs:subClassOf mus:Artista .
mus:Album rdf:type owl:Class .
mus:Album rdfs:comment "Grupo cuyo tipo primario declarado es Album."@es .
mus:Album rdfs:label "Álbum"@es .
mus:Album rdfs:subClassOf mus:GrupoLanzamientos .
mus:AnalisisAcustico rdf:type owl:Class .
mus:AnalisisAcustico rdfs:comment "Mediciones de un mismo análisis, fuente, índice y alcance."@es .
mus:AnalisisAcustico rdfs:label "Análisis acústico"@es .
mus:Artista rdf:type owl:Class .
mus:Artista rdfs:comment "Participante musical; sus roles se expresan mediante relaciones."@es .
mus:Artista rdfs:label "Artista"@es .
mus:AsignacionGenero rdf:type owl:Class .
mus:AsignacionGenero rdfs:comment "Clasificación con fuente y calificadores como papel o votos."@es .
mus:AsignacionGenero rdfs:label "Asignación de género"@es .
mus:AsignacionGenero rdfs:subClassOf _:A10 .
mus:CapturaFuente rdf:type owl:Class .
mus:CapturaFuente rdfs:comment "Archivo, respuesta o instantánea utilizada como evidencia."@es .
mus:CapturaFuente rdfs:label "Captura de fuente"@es .
mus:Correspondencia rdf:type owl:Class .
mus:Correspondencia rdfs:comment "Decisión de reconciliación con estado y método; no es identidad por sí sola."@es .
mus:Correspondencia rdfs:label "Correspondencia"@es .
mus:CreditoArtistico rdf:type owl:Class .
mus:CreditoArtistico rdfs:comment "Artista acreditado en una grabación o grupo, con nombre y orden publicados."@es .
mus:CreditoArtistico rdfs:label "Crédito artístico"@es .
mus:CreditoArtistico rdfs:subClassOf _:A08 .
mus:CreditoArtistico rdfs:subClassOf _:A09 .
mus:EP rdf:type owl:Class .
mus:EP rdfs:comment "Grupo cuyo tipo primario declarado es EP."@es .
mus:EP rdfs:label "EP"@es .
mus:EP rdfs:subClassOf mus:GrupoLanzamientos .
mus:Fuente rdf:type owl:Class .
mus:Fuente rdfs:comment "Proveedor de información."@es .
mus:Fuente rdfs:label "Fuente"@es .
mus:GeneroMusical rdf:type owl:Class .
mus:GeneroMusical rdfs:comment "Clasificación identificada dentro de su vocabulario de origen."@es .
mus:GeneroMusical rdfs:label "Género musical"@es .
mus:Grabacion owl:disjointWith mus:ObraMusical .
mus:Grabacion rdf:type owl:Class .
mus:Grabacion rdfs:comment "Realización sonora; su URI local se conserva al reconciliarla."@es .
mus:Grabacion rdfs:label "Grabación"@es .
mus:GrupoLanzamientos rdf:type owl:Class .
mus:GrupoLanzamientos rdfs:comment "Identidad musical que reúne ediciones relacionadas."@es .
mus:GrupoLanzamientos rdfs:label "Grupo de lanzamientos"@es .
mus:Lanzamiento owl:disjointWith mus:GrupoLanzamientos .
mus:Lanzamiento rdf:type owl:Class .
mus:Lanzamiento rdfs:comment "Edición publicada, no un ejemplar físico individual."@es .
mus:Lanzamiento rdfs:label "Lanzamiento"@es .
mus:ObraMusical rdf:type owl:Class .
mus:ObraMusical rdfs:comment "Composición abstracta que puede tener varias grabaciones."@es .
mus:ObraMusical rdfs:label "Obra musical"@es .
mus:OntologiaMusical rdf:type owl:Ontology .
mus:OntologiaMusical rdfs:comment "Modelo musical y evidencia de la segunda entrega. Dominio abierto; las etiquetas se validan con código."@es .
mus:OntologiaMusical rdfs:label "Ontología musical"@es .
mus:Persona owl:disjointWith mus:Agrupacion .
mus:Persona rdf:type owl:Class .
mus:Persona rdfs:comment "Artista individual identificado explícitamente por la fuente."@es .
mus:Persona rdfs:label "Persona"@es .
mus:Persona rdfs:subClassOf mus:Artista .
mus:PublicacionDiscografica rdf:type owl:Class .
mus:PublicacionDiscografica rdfs:comment "Asociación entre edición y sello que conserva su número de catálogo."@es .
mus:PublicacionDiscografica rdfs:label "Publicación discográfica"@es .
mus:SelloDiscografico rdf:type owl:Class .
mus:SelloDiscografico rdfs:comment "Sello asociado a una edición publicada."@es .
mus:SelloDiscografico rdfs:label "Sello discográfico"@es .
mus:Sencillo rdf:type owl:Class .
mus:Sencillo rdfs:comment "Grupo cuyo tipo primario declarado es Single."@es .
mus:Sencillo rdfs:label "Sencillo"@es .
mus:Sencillo rdfs:subClassOf mus:GrupoLanzamientos .
mus:acreditaEntidad rdf:type owl:ObjectProperty .
mus:acreditaEntidad rdfs:comment "Entidad musical a la que pertenece el crédito."@es .
mus:acreditaEntidad rdfs:domain mus:CreditoArtistico .
mus:acreditaEntidad rdfs:label "acredita entidad"@es .
mus:acreditaEntidad rdfs:range _:union_Grabacion_GrupoLanzamientos .
mus:alcanceAnalisis rdf:type owl:DatatypeProperty .
mus:alcanceAnalisis rdfs:comment "Alcance del audio analizado, por ejemplo fragmento."@es .
mus:alcanceAnalisis rdfs:domain mus:AnalisisAcustico .
mus:alcanceAnalisis rdfs:label "alcance del análisis"@es .
mus:alcanceAnalisis rdfs:range xsd:string .
mus:apareceEn owl:inverseOf mus:contieneGrabacion .
mus:apareceEn rdf:type owl:ObjectProperty .
mus:apareceEn rdfs:comment "Edición que contiene la grabación."@es .
mus:apareceEn rdfs:domain mus:Grabacion .
mus:apareceEn rdfs:label "aparece en"@es .
mus:apareceEn rdfs:range mus:Lanzamiento .
mus:archivoCaptura rdf:type owl:DatatypeProperty .
mus:archivoCaptura rdfs:comment "Ruta relativa de la tabla consolidada en output/csv."@es .
mus:archivoCaptura rdfs:domain mus:CapturaFuente .
mus:archivoCaptura rdfs:label "archivo de captura"@es .
mus:archivoCaptura rdfs:range xsd:string .
mus:artistaAcreditado rdf:type owl:ObjectProperty .
mus:artistaAcreditado rdfs:comment "Artista del crédito; no implica composición ni producción."@es .
mus:artistaAcreditado rdfs:domain mus:CreditoArtistico .
mus:artistaAcreditado rdfs:label "artista acreditado"@es .
mus:artistaAcreditado rdfs:range mus:Artista .
mus:artistaSuministrado rdf:type owl:ObjectProperty .
mus:artistaSuministrado rdfs:comment "Artista reportado en la entrada; no certifica el crédito completo ni su orden."@es .
mus:artistaSuministrado rdfs:domain mus:Grabacion .
mus:artistaSuministrado rdfs:label "artista suministrado"@es .
mus:artistaSuministrado rdfs:range mus:Artista .
mus:bailabilidad rdf:type owl:DatatypeProperty .
mus:bailabilidad rdfs:comment "Valor de AcousticBrainz: danceability; se conserva por análisis."@es .
mus:bailabilidad rdfs:domain mus:AnalisisAcustico .
mus:bailabilidad rdfs:label "bailabilidad"@es .
mus:bailabilidad rdfs:range xsd:decimal .
mus:candidatoMBID rdf:type owl:DatatypeProperty .
mus:candidatoMBID rdfs:comment "Identificador candidato; no afirma identidad ni existencia de relaciones musicales."@es .
mus:candidatoMBID rdfs:domain mus:Correspondencia .
mus:candidatoMBID rdfs:label "MBID candidato"@es .
mus:candidatoMBID rdfs:range xsd:string .
mus:complejidadDinamica rdf:type owl:DatatypeProperty .
mus:complejidadDinamica rdfs:comment "Valor de AcousticBrainz: dynamic_complexity; se conserva por análisis."@es .
mus:complejidadDinamica rdfs:domain mus:AnalisisAcustico .
mus:complejidadDinamica rdfs:label "complejidad dinámica"@es .
mus:complejidadDinamica rdfs:range xsd:decimal .
mus:compuso rdf:type owl:ObjectProperty .
mus:compuso rdfs:comment "Composición respaldada explícitamente por la fuente."@es .
mus:compuso rdfs:domain mus:Artista .
mus:compuso rdfs:label "compuso"@es .
mus:compuso rdfs:range mus:ObraMusical .
mus:contieneGrabacion rdf:type owl:ObjectProperty .
mus:contieneGrabacion rdfs:comment "Grabación incluida en una edición."@es .
mus:contieneGrabacion rdfs:domain mus:Lanzamiento .
mus:contieneGrabacion rdfs:label "contiene grabación"@es .
mus:contieneGrabacion rdfs:range mus:Grabacion .
