mus:medianaSegundoPicoBPM rdfs:range xsd:decimal .
mus:metodoCorrespondencia rdf:type owl:DatatypeProperty .
mus:metodoCorrespondencia rdfs:comment "Método utilizado en la reconciliación."@es .
mus:metodoCorrespondencia rdfs:domain mus:Correspondencia .
mus:metodoCorrespondencia rdfs:label "método de correspondencia"@es .
mus:metodoCorrespondencia rdfs:range xsd:string .
mus:modo rdf:type owl:DatatypeProperty .
mus:modo rdfs:comment "Modo tonal literal; major representa mayor en AcousticBrainz."@es .
mus:modo rdfs:domain mus:AnalisisAcustico .
mus:modo rdfs:label "modo"@es .
mus:modo rdfs:range xsd:string .
mus:nombreAcreditado rdf:type owl:DatatypeProperty .
mus:nombreAcreditado rdfs:comment "Nombre utilizado en el crédito original."@es .
mus:nombreAcreditado rdfs:domain mus:CreditoArtistico .
mus:nombreAcreditado rdfs:label "nombre acreditado"@es .
mus:nombreAcreditado rdfs:range xsd:string .
mus:numeroCatalogo rdf:type owl:DatatypeProperty .
mus:numeroCatalogo rdfs:comment "Número del par edición-sello, conservado literalmente."@es .
mus:numeroCatalogo rdfs:domain mus:PublicacionDiscografica .
mus:numeroCatalogo rdfs:label "número de catálogo"@es .
mus:numeroCatalogo rdfs:range xsd:string .
mus:papelGenero rdf:type owl:DatatypeProperty .
mus:papelGenero rdfs:comment "Papel original: mayoritario o minoritario cuando la fuente lo declara."@es .
mus:papelGenero rdfs:domain mus:AsignacionGenero .
mus:papelGenero rdfs:label "papel del género"@es .
mus:papelGenero rdfs:range xsd:string .
mus:perteneceAGrupo owl:inverseOf mus:tieneLanzamiento .
mus:perteneceAGrupo rdf:type owl:ObjectProperty .
mus:perteneceAGrupo rdfs:comment "Agrupación editorial de una edición."@es .
mus:perteneceAGrupo rdfs:domain mus:Lanzamiento .
mus:perteneceAGrupo rdfs:label "pertenece a grupo"@es .
mus:perteneceAGrupo rdfs:range mus:GrupoLanzamientos .
mus:posicionCredito rdf:type owl:DatatypeProperty .
mus:posicionCredito rdfs:comment "Orden publicado, normalizado a base uno."@es .
mus:posicionCredito rdfs:domain mus:CreditoArtistico .
mus:posicionCredito rdfs:label "posición del crédito"@es .
mus:posicionCredito rdfs:range xsd:positiveInteger .
mus:produjo rdf:type owl:ObjectProperty .
mus:produjo rdfs:comment "Producción respaldada explícitamente por la fuente."@es .
mus:produjo rdfs:domain mus:Artista .
mus:produjo rdfs:label "produjo"@es .
mus:produjo rdfs:range mus:Grabacion .
mus:publicadoPor owl:propertyChainAxiom _:cadenaPublicacion0 .
